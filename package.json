    "bin",
    "lib",
    "template",
    "SKILL.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "video-editing",
    "remotion",
    "captions",
    "whisper",
    "claude",
    "claude-code",
    "ai-video",
    "b-roll",
    "split-screen",
    "reframe",
    "tiktok",
    "reels",
    "shorts",
    "open-source"
  ],
  "repository": {
    "type": "git",
